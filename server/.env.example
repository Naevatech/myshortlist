# =====================================================================
# Shortlist server environment (Node + Express + MySQL)
# Copy this file to `.env` and fill in the values.
# Never commit `.env`. Only commit `.env.example`.
# =====================================================================

# ---------- App ----------
NODE_ENV=development
PORT=4000
# Public URL of the React app. Used in emails and for CORS.
APP_URL=http://localhost:5173
# Public URL of this API.
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ---------- Database (MySQL) ----------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/shortlist

# ---------- Auth (own auth: email one-time code + Google) ----------
# Generate each secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Leave empty in development. Set to your domain in production, e.g. .shortlist.app
COOKIE_DOMAIN=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# 32-byte hex key used to encrypt stored third-party tokens: openssl rand -hex 32
ENCRYPTION_KEY=change-me

# ---------- Google sign-in (Google Cloud Console > Credentials > OAuth client) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------- Email (sign-in codes, daily match email, application emails) ----------
# https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Shortlist <hello@your-domain.com>"

# ---------- AI (CV parsing, match reasons, CV and cover letter writing) ----------
# AI_PROVIDER is "groq" or "openai"
AI_PROVIDER=groq
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://platform.openai.com (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Job listings ----------
# JOB_PROVIDER is "placeholder" for now. Change it later to "adzuna", "reed" or "custom".
JOB_PROVIDER=placeholder
# Generic slot for any provider you plug in later
JOBS_API_BASE_URL=
JOBS_API_KEY=
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://www.reed.co.uk/developers
REED_API_KEY=

# ---------- File storage (uploaded CVs and generated PDFs) ----------
# STORAGE_DRIVER is "local" or "s3" (S3-compatible: AWS S3, Cloudflare R2, etc.)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_CV_SIZE_MB=5

# ---------- Scheduled jobs ----------
# Protects POST /api/cron/* so only your scheduler can call it
CRON_SECRET=change-me
DAILY_MATCH_HOUR=7
DEFAULT_MATCHES_PER_DAY=5
# Seconds a user can undo after approving, before anything is sent
UNDO_WINDOW_SECONDS=10

# ---------- Later (leave empty for now) ----------
# Form-filling browser automation (e.g. Browserbase)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Error tracking
SENTRY_DSN=

# ---------- Passwords and job window ----------
# Password reset link lifetime and password rules
PASSWORD_RESET_TTL_MINUTES=30
MIN_PASSWORD_LENGTH=8

# Only fetch and show jobs posted within this window (days). 14 = 2 weeks.
# Set MIN to 1 to skip jobs posted today.
JOBS_MAX_AGE_DAYS=14
JOBS_MIN_AGE_DAYS=0

# Matches stay under Today > Earlier until their job is this many days old (21 = 3 weeks).
# Jobs you applied to or started are never removed. Must not be less than JOBS_MAX_AGE_DAYS.
JOB_RETENTION_DAYS=21

# Options in Settings: 3, 5, 10, 15, 20, 25, 30
MAX_MATCHES_PER_DAY=30
