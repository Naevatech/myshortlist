# Shortlist client environment (React + Vite)
# Only variables starting with VITE_ are exposed to the browser. Never put secrets here.
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=Shortlist

# Company logos by name (https://www.logo.dev). Publishable key, safe in the browser. Empty shows initials.
VITE_LOGO_DEV_TOKEN=

# Optional: shown on the Contact page. Empty: visitors are told to reply to any Shortlist email.
VITE_CONTACT_EMAIL=
